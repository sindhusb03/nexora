# Copy to .env. Leave DATABASE_URL unset to run the seeded PGlite demo.

# DATABASE_URL=postgres://nexora_app:password@localhost:5432/nexora
# AUTH_SECRET=replace-with-at-least-32-characters
# WEB_ORIGIN=http://127.0.0.1:4317
# NEXORA_DEV_HEADERS=false
# NEXORA_SEED_DEMO=true
# DEMO_MODE=true
# NEXORA_DEMO_PASSWORD=nexora-demo-2026
# SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_TRACES_EXPORTER=none
# OTEL_METRICS_EXPORTER=none
# OIDC_PROVIDERS=
# Signup is off in every environment; reserved/admin IDs can never self-register.
# AUTH_ALLOW_SIGNUP=false
# Required acknowledgement if signup is enabled alongside platform admins.
# AUTH_ALLOW_SIGNUP_WITH_PLATFORM_ADMINS=false
# Empty by default. Only enabled local demo seeding defaults to platform-admin.
# PLATFORM_ADMIN_ACTOR_IDS=
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8787
# API_URL=http://127.0.0.1:8787
